{
  "name": "sunside",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/content.mjs && tsc --noEmit && vite build",
    "lint": "prettier --check src tests scripts *.json *.ts index.html .github",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "suncalc": "2.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
